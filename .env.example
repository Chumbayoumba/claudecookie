# Copy to .env and fill in. .env is gitignored — never commit real values.
DEPLOY_HOST=claudecookie.com
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_PATH=/var/www/claudecookie
# Path to the SSH private key used for deploys (key auth only, no passwords).
DEPLOY_SSH_KEY=~/.ssh/claudecookie_ed25519
# Telegram admin bot
TG_BOT_TOKEN=123456:AA...
TG_OWNER_ID=000000000
