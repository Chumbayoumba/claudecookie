# Copy to .env and fill in. .env is gitignored — never commit real values.
DEPLOY_HOST=claudecookie.com
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_PATH=/var/www/claudecookie
# Path to the SSH private key used for deploys (key auth only, no passwords).
DEPLOY_SSH_KEY=~/.ssh/claudecookie_ed25519
# Telegram admin bot
TG_BOT_TOKEN=123456:AA...
TG_OWNER_ID=000000000
# --- Claude session checker egress (checks only, never Telegram) ---
# A valid cookie arriving from the bare Hetzner IP is the top reason Claude
# revokes the session, so route checks through a *sticky residential* proxy
# (SOCKS5/HTTP with per-session sticky IP and country targeting). Buy one of
# those, not a datacenter proxy.
#
# Single proxy:
# CC_CHECK_PROXY=socks5://user:pass@host:1080
#
# A pool (comma/newline separated) — the checker pins one exit per session:
# CC_CHECK_PROXY_POOL=socks5://a:1080,socks5://b:1080
#
# Or a geo/sticky template — {cc}=visitor country, {sid}=per-session id, so the
# exit IP matches where the cookie was logged in and stays stable per session:
# CC_CHECK_PROXY_TEMPLATE=http://user-country-{cc}-session-{sid}:pass@gw.example:1080
#
# Safe-mode: refuse to check at all (no outbound request) when no proxy resolves,
# instead of burning the cookie from the datacenter IP. Turn ON once a proxy is
# wired in. Default off so checks keep working before you have a proxy.
# CC_REQUIRE_PROXY=1
#
# Neutral Claude-supported exit country for users whose real country is unknown or
# NOT supported by Claude (Russia, China, ...). The checker never egresses through
# an unsupported country (Claude checks IP-country every request and would revoke
# the session); it snaps to this instead. Default us.
# CC_CHECK_DEFAULT_CC=us
#
# Optional: pin the exact claude.ai web client version/sha from a fresh HAR so
# the request headers match the real SPA (leave unset to omit them).
# CC_CLIENT_VERSION=
# CC_CLIENT_SHA=
#
# Cloudflare Turnstile for POST /credential. The secret belongs on the origin
# only (/etc/claudecookie/bot.conf turnstile_secret, or this env). Never commit
# a real value. Production hostnames must not include localhost.
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=claudecookie.com
